# ============================================
# CRYPTO MARKET INTELLIGENCE PLATFORM
# Environment Configuration
# ============================================

# --------------------------------------------
# Database
# --------------------------------------------
DATABASE_URL=postgresql://crypto_user:secure_password@localhost:5432/crypto_db
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=crypto_db

# --------------------------------------------
# Security - GENERATE USING scripts/generate_keys.py
# --------------------------------------------
ENCRYPTION_MASTER_KEY=your_base64_32byte_key_here
ENCRYPTION_SALT=your_base64_16byte_salt_here
JWT_SECRET_KEY=your_jwt_secret_key_here
SECRET_KEY=your_app_secret_key_here

# --------------------------------------------
# External APIs
# --------------------------------------------
COINGECKO_API_KEY=your_coingecko_api_key
GOOGLE_API_KEY=your_google_gemini_api_key

# --------------------------------------------
# Application Settings
# --------------------------------------------
APP_ENV=development
APP_NAME=CryptoMarketIntelligence
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --------------------------------------------
# Caching
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --------------------------------------------
# CORS
# --------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_IP=10

# --------------------------------------------
# ML Settings
# --------------------------------------------
MODEL_PATH=models/
SEQUENCE_LENGTH=60
FORECAST_DAYS=7

# --------------------------------------------
# Monitoring
# --------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000